    <li t-else="" t-on-click="() =&gt; this._onMenuClicked(section)" t-att-data-menu-xmlid="section.xmlid" t-att-class="{             'fw-bold text-900 py-3': !isNested,             'border-top': !isNested &amp;&amp; subMenu_index != 0,             'py-2': isNested,         }">
