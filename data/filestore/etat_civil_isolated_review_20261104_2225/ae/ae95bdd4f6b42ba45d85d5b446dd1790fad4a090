    </t>

    <t t-name="discuss.GifPicker.searchInput">
        <input class="form-control border-0 flex-grow-1 rounded-3 rounded-end-0 o-active" placeholder="Search Klipy" t-model="localState.searchTerm" t-ref="autofocus"/>
