    <t t-name="mail.StatusBarDurationField">
        <div class="o_statusbar_status" t-ref="root" role="radiogroup" aria-label="Statusbar">
            <button t-ref="after" type="button" class="btn btn-secondary dropdown-toggle o_arrow_button o_first" aria-label="More...">
                <t t-call="mail.StatusBarDurationField.Dropdown">
