                <button type="button" class="o_form_button_save btn btn-light border-0 px-1 py-0 lh-sm" data-hotkey="s" t-on-click.stop="save" data-tooltip="Save manually" aria-label="Save manually" t-ref="save">
                    <i class="fa fa-cloud-upload fa-fw"/>
                </button>
                <button type="button" class="o_form_button_cancel btn btn-light border-0 px-1 py-0 lh-sm" data-hotkey="j" t-on-click.stop="discard" data-tooltip="Discard changes" aria-label="Discard changes">
                    <i class="fa fa-undo fa-fw"/>
                </button>
            </div>
