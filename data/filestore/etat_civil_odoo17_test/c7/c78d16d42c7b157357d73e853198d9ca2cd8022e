<t t-name="point_of_sale.ConfirmPopup">
        <div class="popup popup-confirm">
            <div class="modal-header">
                <h4 class="modal-title title drag-handle">
                    <t t-esc="props.title"/>
                </h4>
            </div>
            <main class="modal-body">
                <t t-esc=" props.body"/>
            </main>
