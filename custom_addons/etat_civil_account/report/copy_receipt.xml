<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_etat_civil_receipt_80mm" model="report.paperformat">
        <field name="name">Quittance état civil — rouleau 80 mm</field>
        <field name="format">custom</field>
        <field name="page_width">80</field>
        <field name="page_height">170</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">3</field>
        <field name="margin_left">4</field>
        <field name="margin_right">4</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_copy_payment_receipt" model="ir.actions.report">
        <field name="name">Quittance de versement</field>
        <field name="model">etat.civil.copy.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">etat_civil_account.copy_payment_receipt</field>
        <field name="report_file">etat_civil_account.copy_payment_receipt</field>
        <field name="paperformat_id" ref="paperformat_etat_civil_receipt_80mm"/>
        <field name="groups_id" eval="[(6, 0, [ref('etat_civil.group_etat_civil_admin'), ref('group_etat_civil_regisseur')])]"/>
        <field name="binding_model_id" ref="model_etat_civil_copy_payment"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Quittance - %s' % (object.name)</field>
    </record>

    <template id="copy_payment_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="receipt">
                <t t-set="request" t-value="request_by_receipt_id[receipt.id]"/>
                <t t-set="settings" t-value="settings_by_company.get(receipt.company_id.id)"/>
                <t t-set="receipt_display" t-value="receipt_display_by_id[receipt.id]"/>
                <t t-set="linked_act" t-value="request.acte_naissance_id or request.acte_mariage_id or request.acte_deces_id"/>
                <div class="page ec_receipt article"
                     t-att-data-oe-model="receipt._name" t-att-data-oe-id="receipt.id">
                    <style>
                        .ec_receipt {
                            box-sizing: border-box;
                            width: 72mm;
                            color: #111;
                            font-family: "DejaVu Sans Mono", "Courier New", monospace;
                            font-size: 8pt;
                            line-height: 1.25;
                            overflow-wrap: anywhere;
                        }
                        .ec_receipt p { margin: 0 0 1mm; }
                        .ec_receipt .ec_receipt_label { font-weight: bold; }
                        .ec_receipt .ec_receipt_underline { text-decoration: underline; }
                        .ec_receipt .ec_receipt_right { text-align: right; }
                        .ec_receipt .ec_receipt_center { text-align: center; }
                        .ec_receipt .ec_receipt_paye-stamp {
                            position: relative;
                            display: inline-block;
                        }
                        .ec_receipt .ec_receipt_paye-stamp::after {
                            content: "PAYÉ";
                            position: absolute;
                            top: -2mm;
                            right: -10mm;
                            color: #cc0000;
                            font-size: 10pt;
                            font-weight: bold;
                            border: 2px solid #cc0000;
                            border-radius: 3mm;
                            padding: 1mm 2mm;
                            transform: rotate(-15deg);
                            opacity: 0.7;
                        }
                    </style>
                    <!-- En-tête -->
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <p class="ec_receipt_label">Quittance N° : <span t-field="receipt.name"/></p>
                    </div>
                    <p class="ec_receipt_label">Commune :</p>
                    <p>Kaominina Ambonivohitra <strong t-field="request.center_id.commune"/></p>
                    <p class="ec_receipt_label">Reçu de :</p>
                    <p t-if="linked_act"><span t-field="linked_act.numero_acte"/> / <span t-field="linked_act.registre_id.annee"/></p>
                    <p><span t-field="request.partner_id.name"/></p>
                    <p class="ec_receipt_label">la somme de :</p>
                    <p><span t-esc="receipt_display['amount_in_words']"/> (<span t-esc="receipt_display['paid_amount']"/>)</p>
                    <p class="ec_receipt_label ec_receipt_underline">DESCRIPTION</p>
                    <p t-if="request.document_type"><span t-field="request.document_type"/> — <span t-field="request.copy_kind"/></p>
                    <p>Nombre de copies : <span t-field="request.copy_quantity"/></p>
                    <div class="ec_receipt_paye-stamp">
                        <p>Prix Unitaire : <span t-esc="receipt_display['unit_price']"/></p>
                    </div>
                    <p>Montant : <span t-esc="receipt_display['paid_amount']"/></p>
                    <!-- Bas de page -->
                    <div style="display: flex; justify-content: space-between; margin-top: 2mm;">
                        <p><span t-field="receipt.create_date" t-options="{'widget': 'float_time'}"/></p>
                        <p><span t-field="request.center_id.commune"/>, le <span t-esc="receipt_display['payment_date']"/></p>
                    </div>
                    <p class="ec_receipt_note" style="font-size: 6.5pt; margin-top: 1mm;">
                        Réimpression de la même quittance — aucune nouvelle opération financière.
                    </p>
                </div>
            </t>
        </t>
    </template>
</odoo>
