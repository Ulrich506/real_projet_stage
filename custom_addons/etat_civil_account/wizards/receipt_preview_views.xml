<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_receipt_preview_form" model="ir.ui.view">
        <field name="name">etat.civil.receipt.preview.form</field>
        <field name="model">etat.civil.receipt.preview</field>
        <field name="arch" type="xml">
            <form string="Aperçu de la quittance" class="ec_form_view">
                <header>
                    <button name="action_print_receipt" string="Imprimer" type="object"
                            class="oe_highlight" icon="fa-print"/>
                    <button name="action_close" string="Fermer" special="cancel"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="receipt_name"/>
                        <h1><field name="receipt_name" readonly="1"/></h1>
                    </div>
                    <!-- Aperçu HTML de la quittance, identique au PDF imprimable -->
                    <field name="html_content" widget="html" readonly="1"/>
                    <field name="receipt_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
