<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acte de naissance : compteur et onglet Copies délivrées -->
    <record id="view_etat_civil_acte_naissance_form_copy" model="ir.ui.view">
        <field name="name">etat.civil.acte.naissance.form.copy</field>
        <field name="model">etat.civil.acte.naissance</field>
        <field name="inherit_id" ref="etat_civil.view_etat_civil_acte_naissance_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_title']/div[@class='ec_subtitle']" position="after">
                <div class="text-muted mt-1">
                    <i class="fa fa-copy me-1"/>Copies délivrées : <field name="copies_delivrees_count" readonly="1"/>
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Copies délivrées">
                    <field name="copy_request_ids" readonly="1">
                        <tree create="0" edit="0" delete="0">
                            <field name="name"/>
                            <field name="request_date"/>
                            <field name="copy_kind"/>
                            <field name="copy_quantity"/>
                            <field name="delivered_by_id"/>
                            <field name="delivered_at"/>
                            <field name="state" widget="badge"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

