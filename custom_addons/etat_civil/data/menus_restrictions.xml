        ]"/>
    </record>
    <record id="etat_civil.menu_etat_civil_pieces_requises" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (6, 0, [
                ref('etat_civil.group_etat_civil_admin'),
            ])
        ]"/>
    </record>

    <!-- ================================================================ -->
    <!-- MENUS FINANCIERS (etat_civil_account)                             -->
    <!-- Ces menus sont gérés dans etat_civil_account/views/menus_restrictions.xml -->
    <!-- car ce module ne peut pas référencer les IDs de l'autre module.     -->
    <!-- ================================================================ -->

    <!-- ================================================================ -->
    <!-- APPLICATIONS STANDARD À MASQUER AU RÉGISSEUR                      -->
    <!-- On ne modifie pas les menus standard d'Odoo depuis un module     -->
    <!-- custom. La restriction se fait via les ACL et record rules.       -->
    <!-- Le régisseur n'a pas les groupes nécessaires pour voir ces apps.  -->
    <!-- ================================================================ -->

    <!-- ================================================================ -->
    <!-- APPLICATIONS STANDARD — RESTRICTION PAR RÔLE                     -->
    <!-- Agent et Officier : seuls "Discussion" et "État Civil"            -->
    <!-- Régisseur : POS + Discussion + État Civil (racine vide)           -->
    <!-- Administrateur : tout                                            -->
    <!-- ================================================================ -->

    <!-- Menu "Apps" (base.menu_management) : admin uniquement -->
    <record id="base.menu_management" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (6, 0, [
                ref('base.group_system'),
                ref('etat_civil.group_etat_civil_admin'),
            ])
        ]"/>
    </record><!-- ================================================================ -->
    <!-- RESTRICTIONS SUPPLÉMENTAIRES PAR RÔLE                            -->
    <!-- ================================================================ -->

    <!-- Agent : ne voit pas le POS, Facturation, Inventaire -->
    <!-- Officier : ne voit pas le POS, Facturation, Inventaire, ni les actes de création -->
    <!-- Régisseur : ne voit pas les actes, citoyens, mentions, administration, Facturation, Inventaire -->
    <!-- Les menus sont déjà restreints ci-dessus -->
    <!-- Le régisseur voit : menu racine (vide sauf Quittances) + POS -->

</odoo>
