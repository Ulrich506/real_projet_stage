            ])
        ]"/>
    </record>
    <record id="etat_civil.menu_etat_civil_acte_mariage" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (6, 0, [
                ref('etat_civil.group_etat_civil_agent'),
                ref('etat_civil.group_etat_civil_admin'),
            ])
        ]"/>
    </record>
    <record id="etat_civil.menu_etat_civil_acte_deces" model="ir.ui.menu">
