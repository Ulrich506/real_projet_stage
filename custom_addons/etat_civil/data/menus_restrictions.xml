                ref('etat_civil.group_etat_civil_agent'),
                ref('etat_civil.group_etat_civil_admin'),
            ])
        ]"/>
    </record>

    <!-- Citoyens / Individus : agent + admin uniquement.
         L'officier n'a PAS accès à ce menu. -->
    <record id="etat_civil.menu_etat_civil_citoyens" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (6, 0, [
                ref('etat_civil.group_etat_civil_agent'),
                ref('etat_civil.group_etat_civil_admin'),
            ])
        ]"/>
    </record>

    <!-- Administration : admin uniquement -->
    <record id="etat_civil.menu_etat_civil_config" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (6, 0, [
                ref('etat_civil.group_etat_civil_admin'),
            ])
        ]"/>
    </record>
    <record id="etat_civil.menu_etat_civil_registres" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (6, 0, [
                ref('etat_civil.group_etat_civil_admin'),
            ])
        ]"/>
    </record>
    <record id="etat_civil.menu_etat_civil_centres" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (6, 0, [
                ref('etat_civil.group_etat_civil_admin'),
            ])
        ]"/>
    </record>
    <record id="etat_civil.menu_etat_civil_users" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (6, 0, [
                ref('etat_civil.group_etat_civil_admin'),
            ])
        ]"/>
    </record>
    <record id="etat_civil.menu_etat_civil_users_list" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (6, 0, [
                ref('etat_civil.group_etat_civil_admin'),
            ])
        ]"/>
    </record>
    <record id="etat_civil.menu_etat_civil_users_create" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (6, 0, [
                ref('etat_civil.group_etat_civil_admin'),
            ])
        ]"/>
    </record>
    <record id="etat_civil.menu_etat_civil_users_manage" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (6, 0, [
                ref('etat_civil.group_etat_civil_admin'),
            ])
        ]"/>
    </record>
    <record id="etat_civil.menu_etat_civil_citoyens_import" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (6, 0, [
                ref('etat_civil.group_etat_civil_admin'),
            ])
        ]"/>
    </record>
    <record id="etat_civil.menu_etat_civil_citoyens_export" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (6, 0, [
                ref('etat_civil.group_etat_civil_admin'),
            ])
        ]"/>
    </record>
    <record id="etat_civil.menu_etat_civil_exchange_logs" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (6, 0, [
