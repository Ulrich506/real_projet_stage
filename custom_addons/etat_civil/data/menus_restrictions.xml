<?xml version="1.0" encoding="utf-8"?>
<!--
    Restrictions de menus par rôle.
    
    Régisseur : voit uniquement le POS et les quittances.
    Agent : voit l'application État Civil mais pas le POS ni la comptabilité.
    Officier : voit uniquement les dossiers à examiner.
    Administrateur : voit tout.
    
    Ces règles s'appliquent en ajoutant des groups_id aux menus existants.
    Si un menu n'a pas de groups_id, il est visible par tous les utilisateurs.
-->
<odoo>

    <!-- ================================================================ -->
    <!-- MENUS DE L'APPLICATION ÉTAT CIVIL                                 -->
    <!-- ================================================================ -->

    <!-- Menu racine "État Civil" : visible par agent, officier, admin -->
    <!-- Le régisseur voit le menu racine via etat_civil_account/menus_restrictions_regisseur.xml -->
    <record id="etat_civil.menu_etat_civil_root" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (6, 0, [
                ref('etat_civil.group_etat_civil_agent'),
                ref('etat_civil.group_etat_civil_officier'),
                ref('etat_civil.group_etat_civil_admin'),
            ])
        ]"/>
    </record>

    <!-- Sous-menus de l'application État Civil : PAS pour le régisseur -->

    <!-- File d'attente : agent + admin uniquement.
         L'officier n'a PAS accès à ce menu.
         Le régisseur a son propre menu dédié via etat_civil_pos. -->
    <record id="etat_civil.menu_etat_civil_guichet" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (6, 0, [
                ref('etat_civil.group_etat_civil_agent'),
                ref('etat_civil.group_etat_civil_admin'),
            ])
        ]"/>
    </record>

    <!-- Dossiers à examiner : officier + admin uniquement -->
    <record id="etat_civil.menu_etat_civil_a_valider" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (6, 0, [
                ref('etat_civil.group_etat_civil_officier'),
                ref('etat_civil.group_etat_civil_admin'),
            ])
        ]"/>
    </record>
    <record id="etat_civil.menu_etat_civil_naissance_a_valider" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (6, 0, [
                ref('etat_civil.group_etat_civil_officier'),
                ref('etat_civil.group_etat_civil_admin'),
            ])
        ]"/>
    </record>
    <record id="etat_civil.menu_etat_civil_mariage_a_valider" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (6, 0, [
                ref('etat_civil.group_etat_civil_officier'),
                ref('etat_civil.group_etat_civil_admin'),
            ])
        ]"/>
    </record>
    <record id="etat_civil.menu_etat_civil_deces_a_valider" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (6, 0, [
                ref('etat_civil.group_etat_civil_officier'),
                ref('etat_civil.group_etat_civil_admin'),
            ])
        ]"/>
    </record>

    <!-- Actes : agent + admin uniquement.
         L'officier n'a PAS accès à ce menu ni aux sous-menus (Naissances, Mariages, Décès, Mentions). -->
    <record id="etat_civil.menu_etat_civil_actes" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (6, 0, [
                ref('etat_civil.group_etat_civil_agent'),
                ref('etat_civil.group_etat_civil_admin'),
            ])
        ]"/>
