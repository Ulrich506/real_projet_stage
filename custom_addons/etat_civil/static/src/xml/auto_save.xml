<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Auto-save status indicator shown in the form header -->
    <t t-name="etat_civil.AutoSaveStatus">
        <span
            t-if="state !== 'idle'"
            class="o_etat_civil_auto_save_status text-muted small ms-3"
            style="font-size: 0.75rem; vertical-align: middle;"
        >
            <!-- Pending: waiting for debounce -->
            <span t-if="state === 'pending'" class="text-warning">
                <i class="fa fa-clock-o me-1"/>
                En attente...
            </span>
            <!-- Saving: in progress -->
            <span t-if="state === 'saving'" class="text-info">
                <i class="fa fa-spinner fa-spin me-1"/>
                Sauvegarde...
            </span>
            <!-- Saved: success -->
            <span t-if="state === 'saved'" class="text-success">
                <i class="fa fa-check-circle me-1"/>
                Enregistré
            </span>
            <!-- Error: failed -->
            <span t-if="state === 'error'" class="text-danger">
                <i class="fa fa-exclamation-triangle me-1"/>
                Erreur
            </span>
        </span>
    </t>

</templates>
