            (4, ref('etat_civil.group_etat_civil_admin')),
        ]"/>
    </record>

    <!-- Citoyens : agent + admin uniquement -->
    <record id="etat_civil.menu_etat_civil_citoyens" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (4, ref('etat_civil.group_etat_civil_agent')),
            (4, ref('etat_civil.group_etat_civil_admin')),
        ]"/>
    </record>

    <!-- Administration : admin uniquement -->
    <record id="etat_civil.menu_etat_civil_config" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (4, ref('etat_civil.group_etat_civil_admin')),
        ]"/>
    </record>
    <record id="etat_civil.menu_etat_civil_registres" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (4, ref('etat_civil.group_etat_civil_admin')),
        ]"/>
    </record>
    <record id="etat_civil.menu_etat_civil_centres" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (4, ref('etat_civil.group_etat_civil_admin')),
        ]"/>
    </record>
    <record id="etat_civil.menu_etat_civil_users" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (4, ref('etat_civil.group_etat_civil_admin')),
        ]"/>
    </record>
    <record id="etat_civil.menu_etat_civil_users_list" model="ir.ui.menu">
        <field name="groups_id" eval="[
