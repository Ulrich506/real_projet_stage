<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_etat_civil_audit_log_search" model="ir.ui.view">
        <field name="name">etat.civil.audit.log.search</field>
        <field name="model">etat.civil.audit.log</field>
        <field name="arch" type="xml">
            <search string="Journal d'audit">
                <field name="user_id"/>
                <field name="commune"/>
                <field name="action_type"/>
                <field name="record_model"/>
                <field name="record_id"/>
                <filter name="filter_event_date" string="Date" date="event_datetime_utc"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_user" string="Utilisateur" context="{'group_by': 'user_id'}"/>
                    <filter name="group_commune" string="Commune" context="{'group_by': 'commune'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'event_datetime_utc:day'}"/>
                    <filter name="group_action" string="Type d'action" context="{'group_by': 'action_type'}"/>
                    <filter name="group_model" string="Modèle" context="{'group_by': 'record_model'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_etat_civil_audit_log_tree" model="ir.ui.view">
        <field name="name">etat.civil.audit.log.tree</field>
        <field name="model">etat.civil.audit.log</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0" import="0" duplicate="0">
                <field name="event_datetime_utc"/>
                <field name="event_datetime_local" optional="hide"/>
                <field name="event_timezone" optional="hide"/>
                <field name="user_id"/>
                <field name="role"/>
                <field name="commune"/>
                <field name="action_type"/>
                <field name="record_model"/>
                <field name="record_id"/>
                <field name="result"/>
            </tree>
        </field>
    </record>

    <record id="view_etat_civil_audit_log_form" model="ir.ui.view">
        <field name="name">etat.civil.audit.log.form</field>
        <field name="model">etat.civil.audit.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group string="Événement">
                            <field name="event_uuid"/>
                            <field name="event_datetime_utc"/>
                            <field name="event_datetime_local"/>
                            <field name="event_timezone"/>
                            <field name="result"/>
                        </group>
                        <group string="Auteur et périmètre">
                            <field name="user_id"/>
                            <field name="user_login"/>
                            <field name="role"/>
                            <field name="centre_id"/>
                            <field name="commune"/>
                            <field name="ip_address"/>
                            <field name="session_hash"/>
                            <field name="request_id"/>
                        </group>
                    </group>
                    <group string="Opération">
                        <field name="action_type"/>
                        <field name="record_model"/>
                        <field name="record_id"/>
                        <field name="changed_fields" widget="text"/>
                    </group>
                    <group string="Changements et détails">
                        <field name="old_values" widget="text"/>
                        <field name="new_values" widget="text"/>
                        <field name="details" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_etat_civil_audit_log" model="ir.actions.act_window">
        <field name="name">Journal d'audit</field>
        <field name="res_model">etat.civil.audit.log</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_etat_civil_audit_log_search"/>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'tree', 'view_id': ref('view_etat_civil_audit_log_tree')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_etat_civil_audit_log_form')})]"/>
    </record>
</odoo>
