<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ticket_preview_form" model="ir.ui.view">
        <field name="name">etat.civil.ticket.preview.form</field>
        <field name="model">etat.civil.ticket.preview</field>
        <field name="arch" type="xml">
            <form string="Aperçu du ticket" class="ec_form_view">
                <header>
                    <button name="action_download_ticket" string="Télécharger" type="object" class="oe_highlight" icon="fa-download"/>
                    <button name="action_close" string="Fermer" special="cancel"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="ticket_numero"/>
                        <h1><field name="ticket_numero" readonly="1"/></h1>
                        <field name="statut" widget="badge" readonly="1"/>
                    </div>
                    <!-- Aperçu HTML du ticket, identique au PDF téléchargeable -->
                    <field name="html_content" widget="html" readonly="1"/>
                    <field name="ticket_id" invisible="1"/>
                    <field name="service_product_name" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ticket_preview" model="ir.actions.act_window">
        <field name="name">Voir le ticket</field>
        <field name="res_model">etat.civil.ticket.preview</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
