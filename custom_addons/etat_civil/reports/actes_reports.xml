<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_etat_civil_a4" model="report.paperformat">
        <field name="name">État civil A4 portrait</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">35</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">30</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_acte_naissance" model="ir.actions.report">
        <field name="name">Acte de Naissance</field>
        <field name="model">etat.civil.acte.naissance</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">etat_civil.report_acte_naissance</field>
        <field name="report_file">etat_civil.report_acte_naissance</field>
        <field name="paperformat_id" ref="paperformat_etat_civil_a4"/>
        <field name="groups_id" eval="[(6, 0, [ref('group_etat_civil_agent'), ref('group_etat_civil_officier'), ref('group_etat_civil_admin')])]"/>
        <field name="binding_model_id" ref="model_etat_civil_acte_naissance"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_acte_mariage" model="ir.actions.report">
        <field name="name">Acte de Mariage</field>
        <field name="model">etat.civil.acte.mariage</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">etat_civil.report_acte_mariage</field>
        <field name="report_file">etat_civil.report_acte_mariage</field>
        <field name="paperformat_id" ref="paperformat_etat_civil_a4"/>
        <field name="groups_id" eval="[(6, 0, [ref('group_etat_civil_agent'), ref('group_etat_civil_officier'), ref('group_etat_civil_admin')])]"/>
        <field name="binding_model_id" ref="model_etat_civil_acte_mariage"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_acte_deces" model="ir.actions.report">
        <field name="name">Acte de Décès</field>
        <field name="model">etat.civil.acte.deces</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">etat_civil.report_acte_deces</field>
        <field name="report_file">etat_civil.report_acte_deces</field>
        <field name="paperformat_id" ref="paperformat_etat_civil_a4"/>
        <field name="groups_id" eval="[(6, 0, [ref('group_etat_civil_agent'), ref('group_etat_civil_officier'), ref('group_etat_civil_admin')])]"/>
        <field name="binding_model_id" ref="model_etat_civil_acte_deces"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_physical_document_notice">
        <div t-if="doc.statut in ('brouillon', 'en_attente', 'a_corriger')"
             class="ec_official_notice">
            <strong>DOCUMENT À IMPRIMER POUR VÉRIFICATION / SIGNATURE PHYSIQUE — NON VALIDÉ</strong>
        </div>
        <div t-elif="doc.statut in ('valide', 'rectifie')" class="ec_official_notice">
            <strong>Extrait validé : <span t-field="doc.statut"/></strong>
        </div>
        <div t-else="" class="ec_official_notice">
            <strong>État documentaire : <span t-field="doc.statut"/></strong>
        </div>
    </template>

    <template id="report_administrative_header">
        <table class="ec_document_header">
            <tr>
                <td class="ec_logo_space"/>
                <td class="ec_header_center">
                    <strong><span t-esc="doc.registre_id.centre_id.pays or ''"/></strong><br/>
                    <span t-esc="doc.registre_id.centre_id.district_province or ''"/><br/>
                    <span t-esc="doc.registre_id.centre_id.nom_centre or ''"/><br/>
                    <span>Commune : <span t-esc="doc.registre_id.centre_id.commune or ''"/></span>
                </td>
                <td class="ec_header_right">
                    <strong>Registre</strong><br/>
                    <span t-field="doc.registre_id"/><br/>
                    <span>Feuillet : <span t-field="doc.feuillet_numero"/></span>
                </td>
            </tr>
        </table>
    </template>

    <template id="report_physical_signature_area">
        <table class="ec_signature_area">
            <tr>
                <td>
                    <span class="ec_signature_label">Fait à ____________________, le ____________________</span>
                </td>
                <td style="text-align: right;">
                    <span class="ec_signature_label">Signature manuscrite de l’officier compétent</span>
                </td>
            </tr>
        </table>
    </template>

    <template id="report_physical_document_styles">
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
        <meta charset="utf-8"/>
        <style>
            .ec_acte_page {
                font-family: "Liberation Serif", serif;
                font-size: 11pt;
                color: #000;
                background: #fff;
            }
            .ec_document_header { width: 100%; border-collapse: collapse; }
            .ec_document_header td { vertical-align: middle; }
            .ec_logo_space { width: 28%; height: 48px; }
            .ec_header_center { width: 44%; text-align: center; }
            .ec_header_right { width: 28%; text-align: right; }
            .ec_acte_title {
                text-align: center;
                font-size: 16pt;
                font-weight: bold;
                margin: 10mm 0 4mm;
                text-transform: uppercase;
            }
            .ec_document_meta { margin-bottom: 3mm; }
            .ec_document_meta p,
            .ec_acte_page p { margin: 0 0 1.5mm; line-height: 1.35; }
            .ec_document_body { min-height: 120mm; }
            .ec_official_notice { text-align: right; font-size: 9pt; margin: 2mm 0; }
            .ec_integrity {
                page-break-inside: avoid;
                border-top: 1px solid #000;
                margin-top: 4mm;
                padding-top: 2mm;
                font-size: 9pt;
            }
            .ec_integrity table { width: 100%; }
            .ec_integrity td { vertical-align: top; }
            .ec_signature_area {
                page-break-inside: avoid;
                width: 100%;
                margin-top: 12mm;
                border-collapse: collapse;
            }
            .ec_signature_area td { width: 50%; height: 32mm; vertical-align: bottom; }
            .ec_signature_area .ec_signature_label { border-top: 1px solid transparent; }
        </style>
    </template>

    <template id="report_acte_naissance">
        <t t-call="web.html_container">
            <t t-call="etat_civil.report_physical_document_styles"/>
            <t t-foreach="docs" t-as="doc">
                <div class="page ec_acte_page">
                    <t t-call="etat_civil.report_administrative_header"/>
                    <div class="ec_acte_title">Acte de Naissance</div>
                    <t t-call="etat_civil.report_physical_document_notice"/>
                    <div class="ec_document_meta">
                        <p><strong>N° d’acte :</strong> <span t-field="doc.numero_acte"/></p>
                        <p><strong>Date de dressage :</strong> <span t-field="doc.date_dressage"/></p>
                    </div>
                    <div class="ec_document_body">
                        <p><strong>Nom et prénoms de l’enfant :</strong> <span t-field="doc.enfant_id"/></p>
                        <p><strong>Date et heure de naissance :</strong>
                            <span t-field="doc.enfant_id.date_naissance"/> à
                            <span t-if="doc.heure_naissance is not False" t-field="doc.heure_naissance" t-options="{'widget': 'float_time'}"/>
                        </p>
                        <p t-if="doc.lieu_naissance"><strong>Lieu de naissance :</strong> <span t-field="doc.lieu_naissance"/></p>
                        <p t-if="doc.pere_id"><strong>Père :</strong> <span t-field="doc.pere_id"/></p>
                        <p t-if="doc.mere_id"><strong>Mère :</strong> <span t-field="doc.mere_id"/></p>
                        <p t-if="doc.declarant_id"><strong>Déclarant :</strong> <span t-field="doc.declarant_id"/></p>
                        <div t-if="doc.texte_integral_acte" class="mt-3">
                            <strong>Transcription intégrale :</strong>
                            <div t-field="doc.texte_integral_acte"/>
                        </div>
                        <div t-if="doc.mention_ids">
                            <p><strong>Mentions marginales :</strong></p>
                            <div t-foreach="doc.mention_ids" t-as="mention">
                                <p><span t-field="mention.date_mention"/> — <span t-field="mention.contenu"/></p>
                            </div>
                        </div>
                        <p t-if="doc.statut in ('annule', 'archive') and doc.motif_annulation"><strong>Décision et motif :</strong> <span t-field="doc.motif_annulation"/></p>
                    </div>
                    <div class="ec_integrity" t-if="doc.hash_empreinte_num or doc.qr_code_image">
                        <table><tr>
                            <td style="width: 82%;">
                                <strong>Vérification d’intégrité numérique</strong>
                                <p t-if="doc.hash_empreinte_num"><strong>Empreinte SHA-256 :</strong> <span t-field="doc.hash_empreinte_num"/></p>
                                <p t-if="doc.utilisateur_validation_id"><strong>Validation informatique :</strong> <span t-field="doc.utilisateur_validation_id.name"/> — <span t-field="doc.date_validation"/></p>
                                <p t-if="doc.officier_validateur_id"><strong>Officier compétent désigné :</strong> <span t-field="doc.officier_validateur_id.name"/></p>
                                <p><em>L’empreinte et le QR servent au contrôle d’intégrité ; ils ne constituent pas une signature électronique et ne se substituent pas à la signature manuscrite de l’officier compétent.</em></p>
                            </td>
                            <td t-if="doc.qr_code_image" style="width: 18%; text-align: right;">
                                <img t-att-src="image_data_uri(doc.qr_code_image)" style="width: 22mm; height: 22mm;" alt="QR de vérification"/>
                            </td>
                        </tr></table>
                    </div>
                    <t t-call="etat_civil.report_physical_signature_area"/>
                </div>
            </t>
        </t>
    </template>

    <template id="report_acte_mariage">
        <t t-call="web.html_container">
            <t t-call="etat_civil.report_physical_document_styles"/>
            <t t-foreach="docs" t-as="doc">
                <div class="page ec_acte_page">
                    <t t-call="etat_civil.report_administrative_header"/>
                    <div class="ec_acte_title">Acte de Mariage</div>
                    <t t-call="etat_civil.report_physical_document_notice"/>
                    <div class="ec_document_meta">
                        <p><strong>N° d’acte :</strong> <span t-field="doc.numero_acte"/></p>
                        <p><strong>Date du mariage :</strong> <span t-field="doc.date_mariage"/></p>
                    </div>
                    <div class="ec_document_body">
                        <p><strong>Premier conjoint :</strong> <span t-field="doc.conjoint_1_id"/></p>
                        <p><strong>Second conjoint :</strong> <span t-field="doc.conjoint_2_id"/></p>
                        <p><strong>Lieu du mariage :</strong> <span t-field="doc.lieu_mariage"/></p>
                        <p t-if="doc.regime_matrimonial"><strong>Régime matrimonial :</strong> <span t-field="doc.regime_matrimonial"/></p>
                        <p t-if="doc.temoin_1_id"><strong>Premier témoin :</strong> <span t-field="doc.temoin_1_id"/></p>
                        <p t-if="doc.temoin_2_id"><strong>Second témoin :</strong> <span t-field="doc.temoin_2_id"/></p>
                        <p t-if="doc.donnees_historiques_incompletes"><em>Données historiques incomplètes ; la régularisation doit rester conforme aux archives disponibles.</em></p>
                        <div t-if="doc.texte_integral_acte" class="mt-3">
                            <strong>Transcription intégrale :</strong>
                            <div t-field="doc.texte_integral_acte"/>
                        </div>
                        <div t-if="doc.mention_ids">
                            <p><strong>Mentions marginales :</strong></p>
                            <div t-foreach="doc.mention_ids" t-as="mention">
                                <p><span t-field="mention.date_mention"/> — <span t-field="mention.contenu"/></p>
                            </div>
                        </div>
                        <p t-if="doc.statut in ('annule', 'archive') and doc.motif_annulation"><strong>Décision et motif :</strong> <span t-field="doc.motif_annulation"/></p>
                    </div>
                    <div class="ec_integrity" t-if="doc.hash_empreinte_num or doc.qr_code_image">
                        <table><tr>
                            <td style="width: 82%;">
                                <strong>Vérification d’intégrité numérique</strong>
                                <p t-if="doc.hash_empreinte_num"><strong>Empreinte SHA-256 :</strong> <span t-field="doc.hash_empreinte_num"/></p>
                                <p t-if="doc.utilisateur_validation_id"><strong>Validation informatique :</strong> <span t-field="doc.utilisateur_validation_id.name"/> — <span t-field="doc.date_validation"/></p>
                                <p t-if="doc.officier_validateur_id"><strong>Officier compétent désigné :</strong> <span t-field="doc.officier_validateur_id.name"/></p>
                                <p><em>L’empreinte et le QR servent au contrôle d’intégrité ; ils ne constituent pas une signature électronique et ne se substituent pas à la signature manuscrite de l’officier compétent.</em></p>
                            </td>
                            <td t-if="doc.qr_code_image" style="width: 18%; text-align: right;"><img t-att-src="image_data_uri(doc.qr_code_image)" style="width: 22mm; height: 22mm;" alt="QR de vérification"/></td>
                        </tr></table>
                    </div>
                    <t t-call="etat_civil.report_physical_signature_area"/>
                </div>
            </t>
        </t>
    </template>

    <template id="report_acte_deces">
        <t t-call="web.html_container">
            <t t-call="etat_civil.report_physical_document_styles"/>
            <t t-foreach="docs" t-as="doc">
                <div class="page ec_acte_page">
                    <t t-call="etat_civil.report_administrative_header"/>
                    <div class="ec_acte_title">Acte de Décès</div>
                    <t t-call="etat_civil.report_physical_document_notice"/>
                    <div class="ec_document_meta">
                        <p><strong>N° d’acte :</strong> <span t-field="doc.numero_acte"/></p>
                        <p><strong>Date et heure du décès :</strong> <span t-field="doc.date_deces"/> à <span t-field="doc.heure_deces" t-options="{'widget': 'float_time'}"/></p>
                    </div>
                    <div class="ec_document_body">
                        <p><strong>Défunt :</strong> <span t-field="doc.defunt_id"/></p>
                        <p><strong>Lieu du décès :</strong> <span t-field="doc.lieu_deces"/></p>
                        <p t-if="doc.cause_deces"><strong>Cause du décès :</strong> <span t-field="doc.cause_deces"/></p>
                        <p t-if="doc.declarant_id"><strong>Déclarant :</strong> <span t-field="doc.declarant_id"/></p>
                        <div t-if="doc.texte_integral_acte" class="mt-3">
                            <strong>Transcription intégrale :</strong>
                            <div t-field="doc.texte_integral_acte"/>
                        </div>
                        <div t-if="doc.mention_ids">
                            <p><strong>Mentions marginales :</strong></p>
                            <div t-foreach="doc.mention_ids" t-as="mention">
                                <p><span t-field="mention.date_mention"/> — <span t-field="mention.contenu"/></p>
                            </div>
                        </div>
                        <p t-if="doc.statut in ('annule', 'archive') and doc.motif_annulation"><strong>Décision et motif :</strong> <span t-field="doc.motif_annulation"/></p>
                    </div>
                    <div class="ec_integrity" t-if="doc.hash_empreinte_num or doc.qr_code_image">
                        <table><tr>
                            <td style="width: 82%;">
                                <strong>Vérification d’intégrité numérique</strong>
                                <p t-if="doc.hash_empreinte_num"><strong>Empreinte SHA-256 :</strong> <span t-field="doc.hash_empreinte_num"/></p>
                                <p t-if="doc.utilisateur_validation_id"><strong>Validation informatique :</strong> <span t-field="doc.utilisateur_validation_id.name"/> — <span t-field="doc.date_validation"/></p>
                                <p t-if="doc.officier_validateur_id"><strong>Officier compétent désigné :</strong> <span t-field="doc.officier_validateur_id.name"/></p>
                                <p><em>L’empreinte et le QR servent au contrôle d’intégrité ; ils ne constituent pas une signature électronique et ne se substituent pas à la signature manuscrite de l’officier compétent.</em></p>
                            </td>
                            <td t-if="doc.qr_code_image" style="width: 18%; text-align: right;"><img t-att-src="image_data_uri(doc.qr_code_image)" style="width: 22mm; height: 22mm;" alt="QR de vérification"/></td>
                        </tr></table>
                    </div>
                    <t t-call="etat_civil.report_physical_signature_area"/>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_mention_marginale" model="ir.actions.report">
        <field name="name">Avis de mention marginale</field>
        <field name="model">etat.civil.mention.marginale</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">etat_civil.report_mention_marginale</field>
        <field name="report_file">etat_civil.report_mention_marginale</field>
        <field name="paperformat_id" ref="paperformat_etat_civil_a4"/>
        <field name="groups_id" eval="[(6, 0, [ref('group_etat_civil_officier'), ref('group_etat_civil_admin')])]"/>
        <field name="binding_model_id" ref="model_etat_civil_mention_marginale"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_mention_marginale">
        <t t-call="web.html_container">
            <t t-call="etat_civil.report_physical_document_styles"/>
            <t t-foreach="docs" t-as="doc">
                <div class="page ec_acte_page">
                    <table class="ec_document_header">
                        <tr>
                            <td class="ec_logo_space"/>
                            <td class="ec_header_center"><strong>ÉTAT CIVIL</strong></td>
                            <td class="ec_header_right"><strong>Référence</strong><br/><span t-field="doc.name"/></td>
                        </tr>
                    </table>
                    <div class="ec_acte_title">Avis de mention marginale</div>
                    <div class="ec_document_meta">
                        <p><strong>Type :</strong> <span t-field="doc.type_mention"/></p>
                        <p><strong>Date :</strong> <span t-field="doc.date_mention"/></p>
                        <p t-if="doc.autorite"><strong>Autorité :</strong> <span t-field="doc.autorite"/></p>
                    </div>
                    <div class="ec_document_body">
                        <p t-if="doc.personne_concernee_id"><strong>Personne concernée :</strong> <span t-field="doc.personne_concernee_id"/></p>
                        <p t-if="doc.acte_naissance_id"><strong>Acte de naissance :</strong> <span t-field="doc.acte_naissance_id"/></p>
                        <p t-if="doc.acte_mariage_id"><strong>Acte de mariage :</strong> <span t-field="doc.acte_mariage_id"/></p>
                        <p t-if="doc.acte_deces_id"><strong>Acte de décès :</strong> <span t-field="doc.acte_deces_id"/></p>
                        <p><strong>Contenu :</strong></p>
                        <div t-field="doc.contenu"/>
                        <p class="mt-3"><strong>État :</strong> <span t-field="doc.statut"/></p>
                        <p t-if="doc.reference_notification"><strong>Référence de notification :</strong> <span t-field="doc.reference_notification"/></p>
                    </div>
                    <t t-call="etat_civil.report_physical_signature_area"/>
                </div>
            </t>
        </t>
    </template>
</odoo>
