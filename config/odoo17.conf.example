[options]

; Mot de passe maître de gestion des bases
; ⚠️ CHANGEZ cette valeur avant la première utilisation
admin_passwd = CHANGE_ME

; Connexion PostgreSQL
db_host = 127.0.0.1
db_port = 5432
db_user = odoo17
; ⚠️ CHANGEZ ce mot de passe avant la première utilisation
db_password = CHANGE_ME

; Serveur HTTP
http_interface = 127.0.0.1
http_port = 8071
gevent_port = 8072

; Chemins des modules
; Ajustez selon votre répertoire de projet
addons_path = /path/to/stage_l3_odoo/odoo/addons,/path/to/stage_l3_odoo/custom_addons

; Stockage
; Ajustez selon votre répertoire de projet
data_dir = /path/to/stage_l3_odoo/data

; Logs
; Ajustez selon votre répertoire de projet
logfile = /path/to/stage_l3_odoo/logs/odoo17.log
log_level = info

; Gestion des bases
list_db = True
db_name = etat_civil_odoo17_test

; Optimisation des threads de cron
max_cron_threads = 0
